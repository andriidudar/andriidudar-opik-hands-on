{
  "name": "openai-ts-storybook-illustrations",
  "version": "1.0.0",
  "private": true,
  "description": "Children's picture-book illustrator on the OpenAI SDK.",
  "type": "module",
  "scripts": {
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openai": "^6.0.1",
    "opik": "2.2.105",
    "opik-openai": "2.2.105"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.12"
  },
  "overrides": {
    "opik-openai": {
      "opik": "$opik"
    }
  }
}
