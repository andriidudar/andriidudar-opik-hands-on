{
  "name": "vercel-ai-sveltekit-garden-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Streaming garden-care chat in SvelteKit on the Vercel AI SDK",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
