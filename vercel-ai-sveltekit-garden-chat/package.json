    "@ai-sdk/svelte": "^5.0.146",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "ai": "^7.0.146",
    "dotenv": "^18.0.8",
    "opik": "^2.2.105",
    "opik-vercel": "^2.2.105"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
