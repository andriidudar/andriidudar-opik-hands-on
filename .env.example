# Copy to .env at the repo root and fill in. Every example walks up to this file.
# .env is git-ignored; never commit real keys.

# --- Opik ---
# Local self-hosted Opik (start it with ./opik.sh from https://github.com/comet-ml/opik).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY is only needed for Opik Cloud (https://www.comet.com/opik), not for a local stack.
# OPIK_API_KEY=

# --- LLM providers ---
# Required by almost every example. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: examples that use Claude. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
