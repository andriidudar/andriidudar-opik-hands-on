# Copy to .env (or reuse the repo-root .env; it is found by walking up). Never commit real keys.
OPENAI_API_KEY=
# Local self-hosted Opik. Python also reads ~/.opik.config, so these are optional.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=temporal-py-film-festival-screening
