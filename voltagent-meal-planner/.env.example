# OpenAI: the planner runs on gpt-4o-mini
OPENAI_API_KEY=sk-...

# Local self-hosted Opik (workspace "default"); no API key needed
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api, set your workspace name, and add
# OPIK_API_KEY=

# Optional: Opik project to log to (defaults to voltagent-meal-planner)
# OPIK_PROJECT_NAME=voltagent-meal-planner
